# --- Base-data sources (sensitive — never commit) ---
# Reckoner, MF Monitor, Analytics workbooks live only on the admin's machine
*.xlsx
*.xlsm
*.xls
*.xlsb
uploads/
inputs/

# --- Dashboard backups / broken states from local builds ---
# NOTE: "*.bak" matches only names ENDING in .bak, so the dated snapshots
# (index.html.bak_directeq_20260728, *.bak2 …) need their own patterns.
# Without these a plain `git add .` pushes ~250 MB of backups.
*.bak
*.bak_*
*.bak[0-9]
*.bak[0-9]*
*.broken
*.broken*
*.tmp

# --- Local tooling / scratch ---
.claude/
node_modules/
_testdata/

# --- Misc generated artefacts ---
*.docx
*.pptx
*.pdf

# --- OS / editor noise ---
.DS_Store
Thumbs.db
desktop.ini
*~
.idea/
.vscode/
__pycache__/
*.pyc

# --- Local-only working files Claude wrote into the workspace ---
Centricity_Investment_Proposal.pptx
Centricity_Playbook_Handoff.docx
Dashboard_Build_Prompt.md
